# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin Secret Key for training dashboard API access
ADMIN_SECRET_KEY="eazi_nation_2026"

# ------------------------------------------------------------
# Federation Week Raffle Environment Variables
# ------------------------------------------------------------
# Public Frontend (Vite)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
VITE_PAYSTACK_PUBLIC_KEY="pk_test_..."

# Server-Side Only (Vercel Serverless Functions in /api)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
PAYSTACK_SECRET_KEY="sk_test_..."
# Admin Secret used to unlock /raffle/admin, manual-entry, and admin-orders
ADMIN_SECRET="choose-a-strong-random-secret"

# Resend Email Delivery (Transactional emails for raffle stubs)
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="tickets@nfcsunn.org"
