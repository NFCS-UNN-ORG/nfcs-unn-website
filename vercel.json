{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/raffle",
      "destination": "/raffle-draw",
      "permanent": false
    },
    {
      "source": "/raffle/:path*",
      "destination": "/raffle-draw/:path*",
      "permanent": false
    },
    {
      "source": "/ticket-purchase",
      "destination": "/raffle-draw",
      "permanent": false
    },
    {
      "source": "/ticket-purchase/:path*",
      "destination": "/raffle-draw/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/free-training",
      "destination": "/free-training.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/eazi-admin-portal",
      "destination": "/admin.html"
    },
    {
      "source": "/raffle-draw",
      "destination": "/"
    },
    {
      "source": "/raffle-draw/:path*",
      "destination": "/"
    },
    {
      "source": "/((?!api/|_next/|_static/|[\\w-]+\\.\\w+).*)",
      "destination": "/"
    }
  ]
}
